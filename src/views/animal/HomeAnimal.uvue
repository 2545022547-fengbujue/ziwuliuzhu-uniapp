<template>
  <!--
    动物岛主题首页（HomeAnimal）- 薄壳
    公共布局见 _shared/HomeLayout.vue；本组件仅提供 scroll-view 内顶部的 hero 装饰插槽。
    视觉差异由全局 ui-animal.scss 的 .ui-animal 命名空间覆盖实现。
  -->
  <HomeLayout>
    <template #hero>
      <view class="animal-friends-hero" aria-hidden="true">
        <image
          class="animal-friends-image"
          :src="animalFriendsImg"
          mode="widthFix"
        />
      </view>
    </template>
  </HomeLayout>
</template>

<script setup>
import HomeLayout from '@/views/_shared/HomeLayout.uvue'
// 图片放 assets（非 static）：仅被引用的平台才打包，小程序端不编译本组件故不进包
import animalFriendsImg from '@/assets/themes/animal/animal-friends.png'

// 蒸汽模式：允许全局主题 class 影响本组件（等价原 scoped 的全局覆盖行为）
defineOptions({
  styleIsolation: 'app'
})
</script>

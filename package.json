{
  "id": "ziwuliuzhu-uniapp-x",
  "name": "ziwuliuzhu-uniapp-x",
  "displayName": "子午流注取穴uni-app x版",
  "version": "2.1.1",
  "description": "子午流注取穴系统 - 基于中医时间医学的智能化取穴辅助工具（uni-app x 蒸汽模式）",
  "private": true,
  "scripts": {
    "dev:h5": "uni",
    "dev:app": "uni -p app",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:h5": "uni build",
    "build:app": "uni build -p app",
    "build:mp-weixin": "npm run fonts:base64 && uni build -p mp-weixin",
    "fonts:base64": "node scripts/sync-font-base64.js",
    "postinstall": "patch-package",
    "test": "npm run test:unit && node scripts/run-validation.cjs",
    "test:unit": "vitest run",
    "fonts:verify": "python scripts/verify-font-subsets.py"
  },
  "dependencies": {

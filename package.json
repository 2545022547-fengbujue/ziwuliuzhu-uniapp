{
  "name": "ziwuliuzhu-uniapp",
  "version": "2.0.3",
  "description": "子午流注取穴系统 - 基于中医时间医学的智能化取穴辅助工具",
  "private": true,
  "scripts": {
    "dev:h5": "uni",
    "dev:app": "uni -p app",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:h5": "uni build",
    "build:app": "uni build -p app",
    "build:mp-weixin": "npm run fonts:base64 && uni build -p mp-weixin",
    "fonts:base64": "node scripts/sync-font-base64.js",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-5000820260508001",
    "@dcloudio/uni-app-plus": "3.0.0-alpha-5000820260508001",
    "@dcloudio/uni-app-vite": "3.0.0-alpha-5000820260508001",
    "@dcloudio/uni-components": "3.0.0-alpha-5000820260508001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5000820260508001",
    "lunar-javascript": "^1.6.0",
    "pinia": "^2.1.0",
    "pinia-plugin-persist-uni": "^1.2.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.0",
    "@dcloudio/uni-automator": "3.0.0-alpha-5000820260508001",
    "@dcloudio/uni-cli-shared": "3.0.0-alpha-5000820260508001",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5000820260508001",
    "@dcloudio/uni-stacktracey": "3.0.0-alpha-5000820260508001",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5000820260508001",
    "patch-package": "^8.0.1",
    "sass": "^1.70.0",
    "vite": "^5.0.0"
  }
}

{
  "name": "ziwuliuzhu-uniapp",
  "version": "2.1.1",
  "description": "子午流注取穴系统 - 基于中医时间医学的智能化取穴辅助工具",
  "private": true,
  "scripts": {
    "dev:h5": "uni",
    "dev:app": "uni -p app",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:h5": "uni build",
    "build:app": "uni build -p app",
    "build:mp-weixin": "npm run fonts:base64 && uni build -p mp-weixin",
    "fonts:base64": "node scripts/sync-font-base64.js",
    "postinstall": "patch-package",
    "test": "npm run test:unit && node scripts/run-validation.cjs",
    "test:unit": "vitest run",
    "fonts:verify": "python scripts/verify-font-subsets.py",
    "test:builds": "npm run build:h5 && npm run build:mp-weixin && node scripts/verify-mp-isolation.cjs && npm run build:app"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-5020320260803001",
    "@dcloudio/uni-app-harmony": "3.0.0-alpha-5020320260803001",
    "@dcloudio/uni-app-plus": "3.0.0-alpha-5020320260803001",
    "@dcloudio/uni-app-vite": "3.0.0-alpha-5020320260803001",
    "@dcloudio/uni-components": "3.0.0-alpha-5020320260803001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5020320260803001",
    "@dcloudio/uni-mp-alipay": "3.0.0-alpha-5020320260803001",
    "@dcloudio/uni-mp-baidu": "3.0.0-alpha-5020320260803001",
    "@dcloudio/uni-mp-harmony": "3.0.0-alpha-5020320260803001",
    "@dcloudio/uni-mp-jd": "3.0.0-alpha-5020320260803001",
    "@dcloudio/uni-mp-kuaishou": "3.0.0-alpha-5020320260803001",
    "@dcloudio/uni-mp-lark": "3.0.0-alpha-5020320260803001",
    "@dcloudio/uni-mp-qq": "3.0.0-alpha-5020320260803001",
    "@dcloudio/uni-mp-toutiao": "3.0.0-alpha-5020320260803001",
    "@dcloudio/uni-mp-xhs": "3.0.0-alpha-5020320260803001",
    "@dcloudio/uni-quickapp-webview": "3.0.0-alpha-5020320260803001",
    "lunar-javascript": "^1.6.0",
    "pinia": "^2.1.0",
    "pinia-plugin-persist-uni": "^1.2.0",
    "vue": "3.5.41"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-automator": "3.0.0-alpha-5020320260803001",
    "@dcloudio/uni-cli-shared": "3.0.0-alpha-5020320260803001",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5020320260803001",
    "@dcloudio/uni-stacktracey": "3.0.0-alpha-5020320260803001",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5020320260803001",
    "@resvg/resvg-js": "^2.6.2",
    "@vue/runtime-core": "3.5.41",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^15.11.7",
    "patch-package": "^8.0.1",
    "rollup": "4.14.3",
    "sass": "^1.70.0",
    "vite": "5.2.8",
    "vitest": "^2.1.9"
  }
